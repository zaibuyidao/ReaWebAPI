// Real-host ABI probe. Only run in the isolated profile created by the driver.
function check(label, ok) local(fp) (
  fp = fopen(#log, "a");
  fprintf(fp, "%s\t%s\n", ok ? "PASS" : "FAIL", label);
  fclose(fp);
  !ok ? failures += 1;
);
function diagnostic(label, id) local(fp) (
  extension_api("ReaWeb_GetDiagnostics", #json, id);
  sprintf(#file, "%s/eel-%s.json", #root, label);
  fp = fopen(#file, "w"); fprintf(fp, "%s", #json); fclose(fp);
);
function last_error(label) local(fp) (
  extension_api("ReaWeb_GetLastError", #error);
  check(label, strlen(#error) > 0);
  fp = fopen(#log, "a"); fprintf(fp, "ERROR\t%s\t%s\n", label, #error); fclose(fp);
);
function done() local(fp) (
  fp=fopen(#log,"a"); fprintf(fp,"COMPLETE\t%d failures\n",failures); fclose(fp);
  SetExtState("EEL.API.Probe","done","yes",0);
);
function poll() local(count) (
  time_precise() - started > 30 ? (
    check("async timeout",0);
    extension_api("ReaWeb_Close",main);
    extension_api("ReaWeb_Close",dev);
    done();
  ) : (
    count=0;
    loop(32,
      extension_api("ReaWeb_Receive",#message,main);
      !strcmp(#message,"ready") ? page_ready=1;
      !strcmp(#message,#expected) ? echo_seen=1;
      !strcmp(#message,"frame:frame 中文 🎛") ? frame_seen=1;
      extension_api("ReaWeb_Receive",#message,dev);
      !strcmp(#message,"ready") ? dev_ready=1;
      !strcmp(#message,"echo:dev") ? dev_echo=1;
    );
    stage == 0 && page_ready && dev_ready ? (
      check("IsReady main",extension_api("ReaWeb_IsReady",main));
      check("OpenDev handshake",extension_api("ReaWeb_IsReady",dev));
      diagnostic("hidden",main);
      check("Show",extension_api("ReaWeb_Show",main));
      check("Focus",extension_api("ReaWeb_Focus",main));
      diagnostic("shown",main);
      check("SetDocked true",extension_api("ReaWeb_SetDocked",main,1));
      check("IsDocked true",extension_api("ReaWeb_IsDocked",main));
      check("SetDocked false returns false",!extension_api("ReaWeb_SetDocked",main,0));
      check("IsDocked false",!extension_api("ReaWeb_IsDocked",main));
      check("DevTools accepted",extension_api("ReaWeb_DevTools",main));
      check("Send Unicode",extension_api("ReaWeb_Send",main,#payload));
      check("SetFrame",extension_api("ReaWeb_SetFrame",main,"frame 中文 🎛"));
      check("Send dev",extension_api("ReaWeb_Send",dev,"dev"));
      stage=1;
    );
    stage == 1 && echo_seen && frame_seen && dev_echo ? (
      check("Receive Unicode echo",echo_seen);
      check("SetFrame page delivery",frame_seen);
      check("OpenDev round trip",dev_echo);
      check("SetFrame clear",extension_api("ReaWeb_SetFrame",main,""));
      extension_api("ReaWeb_Receive",#message,main);
      check("Receive empty",strlen(#message)==0);
      check("Close",extension_api("ReaWeb_Close",main));
      check("IsOpen after close",!extension_api("ReaWeb_IsOpen",main));
      check("IsReady after close",!extension_api("ReaWeb_IsReady",main));
      check("Show closed",!extension_api("ReaWeb_Show",main));
      check("Focus closed",!extension_api("ReaWeb_Focus",main));
      check("DevTools closed",!extension_api("ReaWeb_DevTools",main));
      check("Send closed",!extension_api("ReaWeb_Send",main,"x"));
      last_error("Send closed error");
      extension_api("ReaWeb_Receive",#message,main);
      check("Receive closed empty",strlen(#message)==0);
      check("SetFrame closed",!extension_api("ReaWeb_SetFrame",main,"x"));
      extension_api("ReaWeb_GetDiagnostics",#json,-1);
      check("Diagnostics unknown empty object",!strcmp(#json,"{}"));
      extension_api("ReaWeb_Close",dev);
      done();
    ) : defer("poll();");
  );
);

GetResourcePath(#root);
sprintf(#log,"%s/eel.tsv",#root);
sprintf(#path,"%s/app/index.html",#root);
fp=fopen(#log,"w"); fclose(fp);
control_track=GetTrack(0,0);
control_false=CreateNewMIDIItemInProj(control_track,2,4,0);
control_true=CreateNewMIDIItemInProj(control_track,2,4,1);
check("Official optional const bool false",control_false && GetMediaItemInfo_Value(control_false,"D_POSITION")==2);
check("Official optional const bool true",control_true && GetMediaItemInfo_Value(control_true,"D_POSITION")==TimeMap2_QNToTime(0,2));
a=extension_api("ReaWeb_Open",#path);
b=extension_api("ReaWeb_Open",#path);
check("Open path only creates distinct",a>0 && b>0 && a!=b);
extension_api("ReaWeb_Close",a); extension_api("ReaWeb_Close",b);
a=extension_api("ReaWeb_Open",#path,"eel-key");
b=extension_api("ReaWeb_Open",#path,"eel-key","");
c=extension_api("ReaWeb_Open",#path,"eel-key","设置 中文");
d=extension_api("ReaWeb_Open",#path,"eel-key","设置 中文");
check("Open key reuse and empty id",a>0 && a==b);
check("Open named id scope and reuse",c>0 && c==d && c!=a);
check("Open literal zero reuse",extension_api("ReaWeb_Open",#path,"eel-key","",0)==a);
multiple=0;
check("Open variable zero scoped reuse",extension_api("ReaWeb_Open",#path,"eel-key","设置 中文",multiple)==c);
e=extension_api("ReaWeb_Open",#path,"eel-key","",1);
multiple=1;
f=extension_api("ReaWeb_Open",#path,"eel-key","设置 中文",multiple);
check("Open literal one distinct",e>0 && e!=a);
check("Open variable one scoped distinct",f>0 && f!=c && f!=e);
check("Open omitted fourth preserves singleton",extension_api("ReaWeb_Open",#path,"eel-key")==a);
check("Open omitted fourth preserves scope",extension_api("ReaWeb_Open",#path,"eel-key","设置 中文")==c);
extension_api("ReaWeb_Close",e); extension_api("ReaWeb_Close",f);
extension_api("ReaWeb_Close",a); extension_api("ReaWeb_Close",c);
a=extension_api("ReaWeb_Open",#path,"");
b=extension_api("ReaWeb_Open",#path,"");
check("Open empty key creates distinct",a>0 && b>0 && a!=b);
extension_api("ReaWeb_Close",a); extension_api("ReaWeb_Close",b);
#options="{\"instanceKey\":\"eel-ex\",\"id\":\"设置\",\"multiple\":false,\"hidden\":true}";
a=extension_api("ReaWeb_OpenEx",#path,#options);
b=extension_api("ReaWeb_OpenEx",#path,#options);
c=extension_api("ReaWeb_OpenEx",#path,"{\"instanceKey\":\"eel-ex\",\"id\":\"设置\",\"multiple\":true,\"hidden\":true}");
d=extension_api("ReaWeb_OpenEx",#path,#options);
check("OpenEx false reuse",a>0 && a==b);
check("OpenEx true distinct preserves singleton",c>0 && c!=a && d==a);
extension_api("ReaWeb_Close",a); extension_api("ReaWeb_Close",c);
a=extension_api("ReaWeb_OpenEx",#path,"{}");
check("OpenEx empty object",a>0); extension_api("ReaWeb_Close",a);
a=extension_api("ReaWeb_OpenEx",#path,"{\"hidden\":true,\"frameless\":true,\"resizable\":false,\"transparent\":true}");
check("OpenEx appearance options",a>0);
diagnostic("appearance",a); extension_api("ReaWeb_Close",a);
check("OpenEx numeric bool rejected",!extension_api("ReaWeb_OpenEx",#path,"{\"multiple\":1}"));
last_error("OpenEx numeric bool error");
check("OpenEx unknown field rejected",!extension_api("ReaWeb_OpenEx",#path,"{\"unknown\":true}"));
check("OpenEx empty JSON rejected",!extension_api("ReaWeb_OpenEx",#path,""));
check("Open missing file",!extension_api("ReaWeb_Open","missing-probe.html","eel-missing"));
last_error("Open missing error");
main=extension_api("ReaWeb_OpenEx",#path,"{\"instanceKey\":\"eel-main\",\"hidden\":true}");
check("IsOpen",main>0 && extension_api("ReaWeb_IsOpen",main));
check("Send before ready rejected",!extension_api("ReaWeb_Send",main,"too-early"));
last_error("Send before ready error");
sprintf(#file,"%s/dev-url.txt",#root); fp=fopen(#file,"r"); fgets(fp,#url); fclose(fp);
dev=extension_api("ReaWeb_OpenDev",#url);
check("OpenDev",dev>0);
#payload="中文 🎛 \"quoted\" \\ slash\n\ttab";
sprintf(#expected,"echo:%s",#payload);
started=time_precise();
poll();
