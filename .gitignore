# Only release sources and configuration belong in the repository.
# Build outputs, local validation artifacts and dependency caches remain excluded.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/README.zh-CN.md
!/THIRD_PARTY.md
!/LICENSE.md
!/COPYING
!/COPYING.LESSER
!/src/
!/runtime/
!/docs/
/docs/*
!/docs/*.md
/docs/VALIDATION*.md
/docs/SMOKE_TEST*.md
/docs/*-isolation-validation*.md
!/examples/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml

!/tools/
/tools/*
!/tools/package.py
!/tools/package_sdk.py
!/tools/release.py
!/tools/version.py
!/tools/clean_retired_mirror.py
!/tools/bridge_script.py
!/tools/validate_app.py
!/tools/build_webkit_runtime.py
# Generated files inside the allowed source directories.
CMakeFiles/
CMakeCache.txt
__pycache__/
*.py[cod]
*.obj
*.o
*.lib
*.a
*.exp
*.pdb
*.ilk
*.dll
*.dylib
*.so
*.exe
*.zip
*.log
*.tmp
*.user
.vs/
.vscode/
.DS_Store
Thumbs.db

!/tests/
/tests/*
!/tests/*.cpp
!/tests/*.mm
!/tests/*.hpp
!/tests/*.py
!/tests/*.cjs
!/tests/video_renderer_tests.mjs
!/tests/video_presenter_tests.mjs
!/tests/video_surface_layout_tests.mjs
!/tests/video_worker_stream_tests.mjs
!/tests/*.ts
!/tests/*.lua
!/tests/*.eel
!/tests/eel_mixer_smoke.js
!/tests/isolation_emulator.js
!/tests/reapack_check.rb
!/tests/CMakeLists.txt
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/retired-mirror-names.json
!/tests/fixtures/realtime_tracks.js
!/tests/fixtures/realtime_tracks.lua
!/tests/fixtures/realtime_fx.js
!/tests/fixtures/realtime_fx.lua
node_modules/
/examples/templates/modern/dist/
