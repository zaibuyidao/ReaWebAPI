# Only release sources and configuration belong in the repository.
# Build outputs, local validation artifacts and dependency caches remain excluded.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/README.zh-CN.md
!/THIRD_PARTY.md
!/src/
!/runtime/
!/docs/
/docs/*
!/docs/*.md
!/demo/
!/api/
/api/*
!/api/reaper_api.json
!/api/bindings.json
!/api/README.md
!/api/README.zh-CN.md
!/api/changelog/
/api/changelog/*
!/api/changelog/*.md

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml

!/tools/
/tools/*
!/tools/package.py
!/tools/package_sdk.py
!/tools/release.py
!/tools/native_bindings.py
!/tools/validate_app.py
!/tools/api_sync/
/tools/api_sync/*
!/tools/api_sync/*.py

# Generated files inside the allowed source directories.
CMakeFiles/
CMakeCache.txt
__pycache__/
*.py[cod]
*.obj
*.o
*.lib
*.a
*.exp
*.pdb
*.ilk
*.dll
*.dylib
*.so
*.exe
*.zip
*.log
*.tmp
*.user
.vs/
.vscode/
.DS_Store
Thumbs.db

!/tests/
/tests/*
!/tests/*.cpp
!/tests/*.hpp
!/tests/*.py
!/tests/*.cjs
!/tests/*.ts
!/tests/*.lua
!/tests/CMakeLists.txt
/tests/native_abi_generated.cpp
node_modules/
/runtime/modern/dist/
